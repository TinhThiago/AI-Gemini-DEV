    <!-- For demonstration, adding a minimal script to toggle recurring options and activate room cards -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const isRecurringCheckbox = document.getElementById('is-recurring');
            const recurringOptions = document.getElementById('recurring-options');
            const roomCards = document.querySelectorAll('.room-card');
            const selectedRoomBadge = document.querySelector('.selected-room-badge');
            const formTitle = document.querySelector('.form-title');
            const bookingForm = document.getElementById('booking-form');
            const submitButton = bookingForm.querySelector('.btn-submit');
            const cancelButton = bookingForm.querySelector('.btn-cancel');

            isRecurringCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    recurringOptions.classList.add('show');
                } else {
                    recurringOptions.classList.remove('show');
                }
            });

            roomCards.forEach(card => {
                card.addEventListener('click', function() {
                    // Remove 'active' from all other cards
                    roomCards.forEach(rc => rc.classList.remove('active'));
                    // Add 'active' to the clicked card
                    this.classList.add('active');

                    // Update selected room badge
                    const roomName = this.dataset.roomName;
                    selectedRoomBadge.textContent = roomName;
                    selectedRoomBadge.style.display = 'inline-block';
                    formTitle.classList.add('has-room-selected'); // A hypothetical class for styling
                });
            });

            // Handle form submission (example - would typically involve AJAX)
            bookingForm.addEventListener('submit', function(event) {
                event.preventDefault();
                console.log('Form submitted!');
                // Here you would typically gather form data and send it to a backend.
                // For this static HTML, we just log.
                alert('Booking request sent for: ' + document.getElementById('meeting-title').value);
                // Simulate loading
                document.querySelector('.loading-overlay').style.display = 'flex';
                setTimeout(() => {
                    document.querySelector('.loading-overlay').style.display = 'none';
                    // Simulate success toast
                    const toast = document.querySelector('.toast.success');
                    toast.classList.add('show');
                    setTimeout(() => toast.classList.remove('show'), 3000);
                    bookingForm.reset(); // Clear form
                    selectedRoomBadge.style.display = 'none'; // Hide badge
                    roomCards.forEach(rc => rc.classList.remove('active')); // Deactivate room cards
                }, 1500);
            });

            // Handle cancel button (example - would clear form)
            cancelButton.addEventListener('click', function() {
                bookingForm.reset(); // Clear form
                recurringOptions.classList.remove('show'); // Hide recurring options if checked
                selectedRoomBadge.style.display = 'none'; // Hide badge
                roomCards.forEach(rc => rc.classList.remove('active')); // Deactivate room cards
                console.log('Form cancelled.');
            });

            // Initial state for recurring options
            if (isRecurringCheckbox.checked) {
                recurringOptions.classList.add('show');
            } else {
                recurringOptions.classList.remove('show');
            }
        });
    </script>
