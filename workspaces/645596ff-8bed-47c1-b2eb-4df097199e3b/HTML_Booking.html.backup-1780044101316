            currentDateInput.value = currentViewDate.toISOString().split('T')[0]; // Set the date input value

            for (let i = 0; i < 7; i++) {
                const dayElement = document.createElement('div');
                dayElement.className = 'day-column';
                
                const calendarDate = new Date(startOfWeek);
                calendarDate.setDate(startOfWeek.getDate() + i);
                calendarDate.setHours(0,0,0,0); // Normalize time

                const isToday = calendarDate.toDateString() === today.toDateString();
                if (isToday) {
