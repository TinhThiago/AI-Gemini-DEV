        function handleFormSubmit(event) {
            event.preventDefault();
            showLoading(true);

            const formData = new FormData(bookingForm);
            const subject = formData.get('subject');
            const startTime = formData.get('startTime');
            const endTime = formData.get('endTime');
            const attendees = formData.get('attendees');
            const description = formData.get('description');
            const selectedRoomIds = selectedRoomIdsInput.value.split(',').map(id => id.trim()).filter(id => id);
            const bookingId = formData.get('bookingId');
            const isRecurring = isRecurringCheckbox.checked;
            const recurringFrequency = formData.get('recurringFrequency');
            const recurringEndDate = formData.get('recurringEndDate');
            const recurringCount = formData.get('recurringCount');

            // --- Basic Validation ---
            if (!subject || !startTime || !endTime || selectedRoomIds.length === 0) {
                showToast('Subject, Start Time, End Time, and at least one Room are required.', 'error');
                showLoading(false);
                return;
            }

            const startDateTime = new Date(startTime);
            const endDateTime = new Date(endTime);

            if (startDateTime >= endDateTime) {
                showToast('End time must be after start time.', 'error');
                showLoading(false);
                return;
            }
            
            const requestedRoomIds = selectedRoomIds;
            let conflict = false;

            // Check for room availability (simplified check)
            for (const roomId of requestedRoomIds) {
                const roomBookings = bookings.filter(b => b.roomId === roomId);
                const hasConflict = roomBookings.some(b => {
                    const existingStart = new Date(b.startTime);
                    const existingEnd = new Date(b.endTime);
                    // Check for overlap: (StartA < EndB) and (EndA > StartB)
                    return startDateTime < existingEnd && endDateTime > existingStart;
                });

                if (hasConflict) {
                    const room = getRoomById(roomId);
                    showToast(`Room '${room.name}' is already booked during the selected time. Please choose another room or time.`, 'error');
                    conflict = true;
                    break;
                }
            }
            
            if (conflict) {
                showLoading(false);
                return;
            }
            
            // Handle Recurring Bookings (Simplified)
             if (isRecurring && (!recurringEndDate || !recurringCount || recurringCount < 1)) {
                 showToast('For recurring bookings, please specify End Date and Number of Occurrences.', 'warning');
                 showLoading(false);
                 return;
             }

            // Simulate API call
            setTimeout(() => {
                showLoading(false);
                if (bookingId) {
                    // Update existing booking
                    const index = bookings.findIndex(b => b.id === bookingId);
                    if (index !== -1) {
                         bookings[index] = {
                            ...bookings[index],
                            subject: subject,
                            startTime: startTime,
                            endTime: endTime,
                            attendees: attendees,
                            description: description,
                            roomId: requestedRoomIds[0] // For simplicity, only updating one room for now
                        };
                        showToast('Booking updated successfully!', 'success');
                    }
                } else {
                    // Create new booking(s)
                    // For simplicity, create one booking. A real app would handle multiple rooms and recurrence properly.
                    const newBooking = {
                        id: `b${Date.now()}`,
                        subject: subject,
                        startTime: startTime,
                        endTime: endTime,
                        roomId: requestedRoomIds[0],
                        attendees: attendees,
                        description: description
                    };
                    bookings.push(newBooking);
                    showToast('Booking successful!', 'success');
                    
                    // Handle recurrence (basic implementation)
                    if (isRecurring) {
                        console.log('Recurring booking initiated:', {
                            frequency: recurringFrequency, 
                            endDate: recurringEndDate, 
                            count: recurringCount
                        });
                        // In a real scenario, this would involve creating multiple bookings based on the rules.
                    }
                }
                
                resetForm();
                renderRoomList(locationFilter.value);
                renderEventsOnCalendar(); // Re-render calendar with new/updated data
            }, 500); 
        }
        
