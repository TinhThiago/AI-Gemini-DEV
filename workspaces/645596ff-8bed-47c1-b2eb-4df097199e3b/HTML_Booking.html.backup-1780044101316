                if (filterLocation === 'all' || room.location.toLowerCase() === filterLocation.toLowerCase()) {
                    if (!locations[room.location]) {
                        locations[room.location] = [];
                    }
                    locations[room.location].push(room);
                }
            });

            // Sort locations alphabetically
            const sortedLocations = Object.keys(locations).sort();

            sortedLocations.forEach(location => {
                const locationGroup = document.createElement('div');
                locationGroup.className = 'location-group';

                const locationTitle = document.createElement('div');
                locationTitle.className = 'location-title';
                locationTitle.textContent = location;
                locationGroup.appendChild(locationTitle);

                // Sort rooms within a location alphabetically by name
                locations[location].sort((a, b) => a.name.localeCompare(b.name));

                locations[location].forEach(room => {
