            renderEventsOnCalendar();
        }
        
        function renderEventsOnCalendar() {
            const dayBodies = calendarWeek.querySelectorAll('.day-body');
            
            // Clear existing events first
            dayBodies.forEach(body => body.innerHTML = '');

            const calendarStartDate = new Date(currentViewDate);
            calendarStartDate.setDate(currentViewDate.getDate() - currentViewDate.getDay());
            calendarStartDate.setHours(0, 0, 0, 0);

            const calendarEndDate = new Date(calendarStartDate);
            calendarEndDate.setDate(calendarStartDate.getDate() + 6);
            calendarEndDate.setHours(23, 59, 59, 999);
            
            bookings.forEach(booking => {
                const bookingStartTime = new Date(booking.startTime);
                const bookingEndTime = new Date(booking.endTime);
                
                // Check if the booking falls within the current calendar week view
                if (bookingStartTime < calendarEndDate && bookingEndTime > calendarStartDate) {
                    const roomId = booking.roomId;
                    const room = getRoomById(roomId);
                    const roomName = room ? room.name : 'Unknown Room';
                    
                    // Determine which day(s) the event should appear on
                    let currentDate = new Date(calendarStartDate);
                    while(currentDate <= calendarEndDate) {
                         currentDate.setHours(0,0,0,0);
                        const eventDayStart = new Date(currentDate);
                        eventDayStart.setHours(0,0,0,0);
                        const eventDayEnd = new Date(currentDate);
                        eventDayEnd.setHours(23, 59, 59, 999);

                        // Check for overlap with the current day being rendered
                        if (bookingStartTime < eventDayEnd && bookingEndTime > eventDayStart) {
                            const targetDayBody = document.querySelector(`.day-body[data-date="${currentDate.toISOString().split('T')[0]}"]`);
                            if (targetDayBody) {
                                const eventDiv = document.createElement('div');
                                eventDiv.className = 'event-card';
                                eventDiv.dataset.bookingId = booking.id;
                                eventDiv.innerHTML = `
                                    <span class="event-time">${formatTimeForDisplay(bookingStartTime)} - ${formatTimeForDisplay(bookingEndTime)}</span>
                                    <span class="event-title">${booking.subject} (${roomName})</span>
                                    <div class="event-tooltip">
                                        <div class="tooltip-row">
                                            <span class="tooltip-label">Subject</span>
                                            <span class="tooltip-value">${booking.subject}</span>
                                        </div>
                                        <div class="tooltip-row">
                                            <span class="tooltip-label">Room</span>
                                            <span class="tooltip-value">${roomName}</span>
                                        </div>
                                        <div class="tooltip-row">
                                            <span class="tooltip-label">Attendees</span>
                                            <span class="tooltip-value">${booking.attendees || 'N/A'}</span>
                                        </div>
                                        ${booking.description ? `<div class="tooltip-row">
                                            <span class="tooltip-label">Description</span>
                                            <span class="tooltip-value">${booking.description}</span>
                                        </div>` : ''}
                                        <div class="tooltip-actions">
                                            <button class="btn-tool btn-tool-edit" onclick="editBooking('${booking.id}')"><i class="fas fa-edit"></i> Edit</button>
                                            <button class="btn-tool btn-tool-del" onclick="deleteBookingPrompt('${booking.id}')"><i class="fas fa-trash"></i> Delete</button>
                                            <button class="btn-tool btn-tool-copy" onclick="copyBookingLink('${booking.id}')"><i class="fas fa-link"></i> Copy</button>
                                        </div>
                                    </div>
                                `; 
                                targetDayBody.appendChild(eventDiv);
                            }
                        }
                        currentDate.setDate(currentDate.getDate() + 1);
                    }
                }
            });
        }

