        function goToPreviousWeek() {
            currentViewDate.setDate(currentViewDate.getDate() - 7);
            renderCalendar();
        }

        function goToNextWeek() {
            currentViewDate.setDate(currentViewDate.getDate() + 7);
            renderCalendar();
        }
        
        function goToToday() {
             currentViewDate = new Date();
             renderCalendar();
        }

        function changeDate(event) {
             const newDate = new Date(event.target.value);
             // Set the currentViewDate to the selected date, but maintain the start of its week for rendering
             const diff = newDate.getDate() - currentViewDate.getDate();
             currentViewDate.setDate(currentViewDate.getDate() + diff);
             currentViewDate.setHours(0,0,0,0); // Reset time to avoid potential issues
             renderCalendar();
        }

        // --- Initialization ---
        function initialize() {
            // Set initial date input value and render calendar
            currentViewDate = new Date();
            currentViewDate.setHours(0,0,0,0); // Normalize time
            currentDateInput.value = currentViewDate.toISOString().split('T')[0];
            
            renderRoomList();
            renderCalendar();
            populateRoomMultiSelect();

            // Add event listeners
            bookingForm.addEventListener('submit', handleFormSubmit);
            locationFilter.addEventListener('change', handleLocationFilterChange);
            prevWeekBtn.addEventListener('click', goToPreviousWeek);
            nextWeekBtn.addEventListener('click', goToNextWeek);
            todayBtn.addEventListener('click', goToToday);
            currentDateInput.addEventListener('change', changeDate);
            isRecurringCheckbox.addEventListener('change', () => {
                 recurringOptionsDiv.style.display = isRecurringCheckbox.checked ? 'grid' : 'none';
            });
            roomSelectHeader.addEventListener('click', handleMultiSelectHeaderClick);
            roomSelectHeader.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') handleMultiSelectHeaderClick(); });
            btnCancelUpdate.addEventListener('click', resetForm);
        }

        // Global functions for inline onclick events
        window.editBooking = editBooking;
        window.deleteBookingPrompt = deleteBookingPrompt;
        window.copyBookingLink = copyBookingLink;

        initialize();

    </script>
</body>

</html>