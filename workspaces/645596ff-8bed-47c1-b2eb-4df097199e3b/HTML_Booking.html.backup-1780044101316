        // --- Multi-select Logic ---
        function populateRoomMultiSelect() {
             roomSelectOptions.innerHTML = ''; // Clear previous options
             const selectedIds = selectedRoomIdsInput.value.split(',').map(id => id.trim()).filter(id => id);
             let allSelected = true;

            meetingRooms.forEach(room => {
                const optionDiv = document.createElement('div');
                const isSelected = selectedIds.includes(room.id);
                if (isSelected) {
                    optionDiv.innerHTML = `
                        <input type="checkbox" id="room_${room.id}" data-room-id="${room.id}" checked>
                        <label for="room_${room.id}">${room.name} (${room.location})</label>
                    `;
                } else {
                    optionDiv.innerHTML = `
                        <input type="checkbox" id="room_${room.id}" data-room-id="${room.id}">
                        <label for="room_${room.id}">${room.name} (${room.location})</label>
                    `;
                    allSelected = false; // Found at least one unselected room
                }
                optionDiv.className = 'multi-select-option';
                optionDiv.querySelector('input[type="checkbox"]').addEventListener('change', handleMultiSelectChange);
                roomSelectOptions.appendChild(optionDiv);
            });
            
            updateMultiSelectHeader(allSelected);
        }

        function handleMultiSelectHeaderClick() {
            roomSelectOptions.classList.toggle('show');
        }
        
        function handleMultiSelectChange(event) {
            const checkbox = event.target;
            const roomId = checkbox.dataset.roomId;
            let currentSelectedIds = selectedRoomIdsInput.value.split(',').map(id => id.trim()).filter(id => id);
            
            if (checkbox.checked) {
                if (!currentSelectedIds.includes(roomId)) {
                    currentSelectedIds.push(roomId);
                }
            } else {
                currentSelectedIds = currentSelectedIds.filter(id => id !== roomId);
            }
            
            selectedRoomIdsInput.value = currentSelectedIds.join(',');
            updateMultiSelectHeader(false); // Update header text, assume not all selected initially
        }
        
        function updateMultiSelectHeader(allSelected) {
            const selectedIds = selectedRoomIdsInput.value.split(',').map(id => id.trim()).filter(id => id);
            let headerText = '';
            if (selectedIds.length === 0) {
                headerText = 'Select Room(s)';
            } else if (selectedIds.length === 1) {
                headerText = getRoomById(selectedIds[0])?.name || 'Select Room(s)';
            } else {
                 headerText = `${selectedIds.length} rooms selected`;
            }
             // Update the text node of the header
             if (roomSelectHeader.firstChild && roomSelectHeader.firstChild.nodeType === Node.TEXT_NODE) {
                 roomSelectHeader.firstChild.textContent = headerText;
             }
            // Keep the icon
            roomSelectHeader.querySelector('i').className = 'fas fa-caret-down';
        }

