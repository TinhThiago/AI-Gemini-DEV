            showLoading(true);
            setTimeout(() => {
                const booking = getBookingById(bookingId);
                if (booking) {
                    isEditing = true;
                    bookingIdInput.value = booking.id;
                    bookingSubject.value = booking.subject;
                    bookingStartTime.value = formatDateForInput(new Date(booking.startTime));
                    bookingEndTime.value = formatDateForInput(new Date(booking.endTime));
                    bookingAttendees.value = booking.attendees;
                    bookingDescription.value = booking.description;
                    
                    // Update room selection
                    selectedRoomIdsInput.value = booking.roomId;
                    selectedRoomBadge.textContent = `${getRoomById(booking.roomId)?.name} (${getRoomById(booking.roomId)?.location})`;
